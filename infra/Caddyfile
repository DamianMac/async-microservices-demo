http://api.localtest.me {
    handle_path /catalog/* {
        reverse_proxy host.docker.internal:5263 host.docker.internal:5264 {
            lb_policy round_robin
            health_uri /health
            health_interval 30s
            lb_try_duration 5s
            fail_duration 30s
        }
    }
    handle_path /orders/* {
        reverse_proxy host.docker.internal:5053 host.docker.internal:5054 {
            lb_policy round_robin
            health_uri /health
            health_interval 30s
            lb_try_duration 5s
            fail_duration 30s
        }
    }
    handle_path /search/* {
        reverse_proxy host.docker.internal:5069
    }
    handle_path /profile/* {
        reverse_proxy host.docker.internal:5311
    }
}

