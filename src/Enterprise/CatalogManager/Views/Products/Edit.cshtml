@model ProductEditViewModel
@{
    var product = Model.Product!;
    ViewData["Title"] = product.Name;
    ViewData["Section"] = "products";
}

<div class="page-header">
    <div>
        <a class="breadcrumb-link" asp-action="Index">&larr; Products</a>
        <h1 class="page-title">@product.Name</h1>
        <p class="page-subtitle sku">@product.Sku</p>
    </div>
    <partial name="_ProductStatus" model="product" />
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <form class="panel" asp-action="Edit" asp-route-id="@product.Id" method="post">
            <div class="panel-header"><h2 class="panel-title">Listing</h2></div>
            <div class="panel-body">
                <div class="mb-4">
                    <label class="form-label fw-medium" asp-for="Description"></label>
                    <textarea class="form-control" asp-for="Description" rows="4"></textarea>
                    <span class="text-danger small" asp-validation-for="Description"></span>
                    <div class="form-text">Shown on the storefront product page.</div>
                </div>
                <div class="price-field">
                    <label class="form-label fw-medium" asp-for="Price"></label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input class="form-control num" asp-for="Price" type="number" step="0.01" min="0.01" asp-format="{0:0.00}" />
                    </div>
                    <span class="text-danger small" asp-validation-for="Price"></span>
                    <div class="form-text">Leave blank to mark the product as needing a price.</div>
                </div>
            </div>
            <div class="panel-footer">
                <a class="btn btn-link text-secondary" asp-action="Index">Cancel</a>
                <button class="btn btn-primary" type="submit">Save changes</button>
            </div>
        </form>
    </div>
    <div class="col-lg-4">
        <div class="panel">
            @if (product.ImageUrl is not null)
            {
                <img class="product-image" src="@product.ImageUrl" alt="@product.Name" />
            }
            <div class="panel-body">
                <dl class="detail-list">
                    <dt>SKU</dt><dd class="sku">@product.Sku</dd>
                    <dt>Category</dt><dd class="category">@product.Category.Replace('-', ' ')</dd>
                    @if (product.Coffee is { } coffee)
                    {
                        <dt>Origin</dt><dd>@coffee.Origin</dd>
                        <dt>Region</dt><dd>@coffee.Region</dd>
                        <dt>Process</dt><dd class="category">@coffee.Process</dd>
                        <dt>Roast</dt><dd class="category">@coffee.Roast.Replace('-', ' ')</dd>
                        <dt>Weight</dt><dd>@coffee.WeightGrams g</dd>
                        <dt>Notes</dt><dd class="category">@string.Join(", ", coffee.TastingNotes)</dd>
                    }
                    <dt>Updated</dt><dd>@product.UpdatedAt.ToLocalTime().ToString("d MMM yyyy, h:mm tt", Formats.Currency)</dd>
                </dl>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
