@model List<Product>
@{
    ViewData["Title"] = "Products";
    ViewData["Section"] = "products";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Products</h1>
        <p class="page-subtitle">@Model.Count products in the catalog.</p>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Import">
        <svg viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="m7 10 5 5 5-5M12 15V3"/></svg>
        Import products
    </a>
</div>

<partial name="_Flash" />

<div class="panel">
    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <h2>No products yet</h2>
            <p>Import the product list to start building the catalog.</p>
            <a class="btn btn-primary" asp-action="Import">Import products</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table data-table">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Category</th>
                        <th class="num">Price</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model)
                    {
                        <partial name="_ProductRow" model="product" />
                    }
                </tbody>
            </table>
        </div>
    }
</div>
