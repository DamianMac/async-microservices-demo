@inject IConfiguration Configuration
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Catalog Manager</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
@{
    var section = ViewData["Section"] as string ?? "dashboard";
}
<body>
    <div class="app-shell">
        <aside class="sidebar" id="sidebar">
            <a class="sidebar-brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 8h1a4 4 0 1 1 0 8h-1"/><path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"/><path d="M6 2v2M10 2v2M14 2v2"/></svg>
                </span>
                <span>
                    <span class="brand-name">Catalog Manager</span>
                    <span class="brand-sub">Nimbus Coffee Co.</span>
                </span>
            </a>

            <nav class="sidebar-nav" aria-label="Main">
                <div class="nav-group">
                    <div class="nav-group-label">Overview</div>
                    <a class="nav-item @(section == "dashboard" ? "active" : "")" asp-controller="Home" asp-action="Index">
                        <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="9" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/><rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="16" width="7" height="5" rx="1"/></svg>
                        Dashboard
                    </a>
                </div>
                <div class="nav-group">
                    <div class="nav-group-label">Catalog</div>
                    <a class="nav-item @(section == "products" ? "active" : "")" asp-controller="Products" asp-action="Index">
                        <svg viewBox="0 0 24 24"><path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5M12 22V12"/></svg>
                        Products
                    </a>
                    <a class="nav-item @(section == "import" ? "active" : "")" asp-controller="Products" asp-action="Import">
                        <svg viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="m7 10 5 5 5-5M12 15V3"/></svg>
                        Import
                    </a>
                </div>
                <div class="nav-group">
                    <div class="nav-group-label">Commerce</div>
                    <a class="nav-item @(section == "publishing" ? "active" : "")" asp-controller="Publishing" asp-action="Index">
                        <svg viewBox="0 0 24 24"><path d="M22 2 11 13"/><path d="M22 2 15 22l-4-9-9-4Z"/></svg>
                        Publishing
                    </a>
                </div>
            </nav>

            <div class="sidebar-footer">
                <span class="env-dot" aria-hidden="true"></span>
                Local demo · @Configuration["Instance"]
            </div>
        </aside>

        <div class="main-area">
            <header class="topbar">
                <button class="btn btn-icon d-lg-none" type="button" aria-label="Toggle navigation"
                        onclick="document.getElementById('sidebar').classList.toggle('open')">
                    <svg viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
                </button>
                <div class="topbar-search">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
                    <input type="search" placeholder="Search products by name or SKU" aria-label="Search products" disabled />
                </div>
                <div class="topbar-right">
                    <span class="channel-pill" title="Publishing target">
                        <span class="env-dot" aria-hidden="true"></span> Storefront: shop.localtest.me
                    </span>
                    <span class="avatar" title="Catalog team">CT</span>
                </div>
            </header>

            <main role="main" class="content">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
